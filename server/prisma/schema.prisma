generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model StockPortfolio {
  id            String          @id @default("default-portfolio")
  name          String          @default("MooMoo 美股主仓位")
  cashBalance   Float           @default(0.0)
  totalBudget   Float           @default(1000.0)
  riskPreference String         @default("BALANCED")
  updatedAt     DateTime        @updatedAt
  createdAt     DateTime        @default(now())

  positions     StockPosition[]
  snapshots     PortfolioSnapshot[]
  strategies    DailyStrategy[]
  retrospectives StrategyRetrospective[]
  knowledgeGraphs StockKnowledgeGraphStore[]
}

model StockPosition {
  id            String         @id @default(uuid())
  portfolioId   String
  symbol        String
  companyName   String?
  shares        Float          @default(0)
  costBasis     Float          @default(0)
  marketPrice   Float          @default(0)
  notes         String?
  updatedAt     DateTime       @updatedAt

  portfolio     StockPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, symbol])
}

model PortfolioSnapshot {
  id               String         @id @default(uuid())
  portfolioId      String
  snapshotDate     String         // YYYY-MM-DD
  totalMarketValue Float
  totalCostBasis   Float
  cashBalance      Float
  totalPnL         Float
  totalPnLPct      Float
  positionsJson    String         // JSON representation of holding positions
  createdAt        DateTime       @default(now())

  portfolio        StockPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model DailyStrategy {
  id                    String         @id @default(uuid())
  portfolioId           String
  strategyDate          String         // YYYY-MM-DD
  marketOverview        String
  existingGuidance      String?
  newGuidance           String?
  actionsJson           String         // JSON list of ActionItems (BUY, SELL, TRIM, HOLD)
  riskAlertsJson        String         // JSON list of RiskAlerts
  deductionPipelineJson String?        // JSON representation of LLM prompts, input contexts, and raw outputs
  retroPnLScore         Float?         // Evaluated accuracy score (0-100)
  createdAt             DateTime       @default(now())

  portfolio             StockPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  retrospectives        StrategyRetrospective[]
}

model StrategyRetrospective {
  id                 String         @id @default(uuid())
  portfolioId        String
  strategyId         String?
  retroDate          String         // YYYY-MM-DD
  accuracyScore      Float          @default(85.0)
  executionMatchRate Float          @default(90.0)
  avoidedLoss        Float          @default(0.0)
  totalRealizedPnL   Float          @default(0.0)
  summaryText        String
  lessonsLearnedJson String         // JSON array of distilled trading disciplines / lessons
  createdAt          DateTime       @default(now())

  portfolio          StockPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  strategy           DailyStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
}

model StockKnowledgeGraphStore {
  id                String         @id @default(uuid())
  portfolioId       String
  symbol            String         // Stock symbol
  nodesJson         String         // JSON array of KnowledgeGraphEntityNode
  edgesJson         String         // JSON array of KnowledgeGraphRelationEdge
  newsCatalystsJson String         // JSON array of news catalyst strings
  guidanceText      String?
  compressedSummary String?        // Distilled long-term memory summary after decay/forgetting
  lastCompressedAt  DateTime?
  updatedAt         DateTime       @updatedAt

  portfolio         StockPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, symbol])
}

model StockFundamentalsStore {
  id                 String   @id @default(uuid())
  symbol             String   @unique
  companyName        String?
  peRatio            Float?
  revenueGrowthPct   Float?
  netMarginPct       Float?
  debtToEquity       Float?
  nextEarningsDate   String?
  fundamentalSummary String?
  updatedAt          DateTime @updatedAt
}

model StockMarketIntelCache {
  id        String   @id @default(uuid())
  intelDate String
  symbol    String?
  title     String
  summary   String
  source    String
  createdAt DateTime @default(now())
}

model DailyMacroSnapshot {
  id               String   @id @default(uuid())
  snapshotDate     String   @unique // YYYY-MM-DD
  createdAt        DateTime @default(now())

  // 宏观 Regime 量化特征
  regimeMood       String   // "BULLISH" | "BEARISH" | "NEUTRAL" | "VOLATILE"
  regimeScore      Float    // 0~100
  stanceBias       String   // 操盘基调 (如 "中性震荡 · 控仓观望")
  positionCapPct   Float    // 建议最大仓位上限 (40%~80%)
  stopLossPct      Float    // 推荐软止损红线 (5%~8%)

  // 跨资产锚点 (JSON: { vix, vixChange, us10y, dxy, spyChange, qqqChange })
  crossAssetJson   String

  // 11大行业板块强弱与资金流矩阵 (JSON: Array<SectorSnapshotItem>)
  sectorMatrixJson String

  // 权威信源精选事件与预期差 (JSON: Array<CredibleNewsItem>)
  topNewsJson      String

  // 因果传导注入 Prompt 纯净 Context
  promptContext    String
}

model StockDeductionLog {
  id                    String    @id @default(uuid())
  portfolioId           String    @default("default-portfolio")
  strategyId            String?
  deductionDate         String    // YYYY-MM-DD
  symbol                String
  companyName           String?

  // 1. 标准化操盘动作与因果核心论据
  action                String    // "BUY" | "TRIM" | "HOLD" | "SELL" (兼容字段)
  actionType            String    @default("HOLD_AND_WATCH") // "OPEN_POSITION" | "ADD_POSITION" | "TRIM_POSITION" | "CLOSE_POSITION" | "HOLD_AND_WATCH"
  whySummary            String?   // 直击核心的为什么操盘论据
  strategyCategory      String?
  suggestedShares       Float     @default(0)
  triggerPrice          Float     // 当时的现价
  targetPrice           Float?
  stopLossPrice         Float?
  entryZoneMin          Float?    // 建议挂单建仓区间下界
  entryZoneMax          Float?    // 建议挂单建仓区间上界
  timeStopDays          Int?      @default(5) // 时间止损 T 日纪律
  certaintyScore        Float?    @default(50.0) // 确定性得分 (0-100)
  goalAttainmentProbability Float? @default(50.0) // T日目标达成测算概率 (%)
  rationale             String

  // 2. 5 大客观事实证据支柱结构化快照 (JSON)
  evidenceNewsJson          String?   @default("[]") // 支柱 1: 权威搜索与新闻分级快照
  evidenceFundamentalsJson  String?   // 支柱 2: 基本面与财务估值快照
  evidenceLiveMarketJson    String?   // 支柱 3: 实盘持仓成本与盘口资金流快照
  evidenceTimeFmJson        String?   // 支柱 4: Google TimeFM 时序动量预测快照
  evidencePastLessonsJson   String?   @default("[]") // 支柱 5: 历史实盘核验反哺教训快照

  // 兼容老字段
  searxngNewsJson       String    @default("[]")
  knowledgeGraphJson    String?
  fundamentalsJson      String?
  timefmDirection       String?   // "UP" | "DOWN" | "SIDEWAYS"
  timefmPredictedPrice  Float?    // 预测次日现价
  timefmPredictedChange Float?    // 预测次日涨跌幅 %
  timefmConfidenceLow   Float?    // 10% 分位数下界
  timefmConfidenceHigh  Float?    // 90% 分位数上界

  // 3. 实盘检验与三态归因 (次日启动时通过 OpenD 自动回填)
  isVerified            Boolean   @default(false)
  verifiedAt            DateTime?
  actualNextClosePrice  Float?    // 次日实盘实际收盘价
  actualNextChangeRate  Float?    // 次日实盘实际涨跌幅 %
  verificationOutcome   String?   // "EXPERIENCE" (成功经验) | "LESSON" (失败教训) | "RANDOM_NOISE" (随机噪音)
  verificationLesson    String?   // 提炼的经验/教训描述
  pnlImpactAmount       Float?    // 实际产生收益或规避损失金额

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([portfolioId, deductionDate, symbol])
  @@index([symbol, deductionDate])
  @@index([portfolioId, deductionDate])
}

model StockTradingMemoryStore {
  id                 String   @id @default(uuid())
  portfolioId        String   @default("default-portfolio")
  symbol             String   // 标的代码或 "GLOBAL"
  principleType      String   @default("INDIVIDUAL_STOCK") // "INDIVIDUAL_STOCK" | "SECTOR_RULE" | "GLOBAL_DISCIPLINE"
  category           String   // "ENTRY_DISCIPLINE" | "STOP_LOSS_RULE" | "TAKE_PROFIT_RULE" | "EVENT_CATALYST"
  title              String   // 简短规则标题
  distilledRule      String   // 完整蒸馏高阶原则描述
  sampleCount        Int      @default(1) // 归纳合并的历史样本数量
  confidenceWeight   Float    @default(1.0) // 置信度与激活权重 (0.0 ~ 1.0, 随时间衰减/重复触发强化)
  firstLearnedDate   String   // 首次提炼日期 YYYY-MM-DD
  lastReinforcedDate String   // 最近强化/重组日期 YYYY-MM-DD
  isArchived         Boolean  @default(false) // 是否因长期未触发或权重大幅衰减移入冷归档
  evidenceLogsJson   String   @default("[]") // 支撑此原则的历史推演日志 ID 列表

  // Holistic Context 半开时态有效区间与变更追溯 (Additive)
  validStart         String?  // 生效日期 YYYY-MM-DD
  validEnd           String?  // 失效日期 YYYY-MM-DD (null 表示当前持续活跃 +∞)
  supersededById     String?  // 指向取代本原则的新原则 ID
  supersedeReason    String?  // 变更/推翻的具体因果解释与证据摘要
  evidenceWeightSum  Float?   @default(1.0) // 支撑此原则的累计证据加权分

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([portfolioId, symbol, category, title])
  @@index([portfolioId, symbol, isArchived])
  @@index([validStart, validEnd])
}



